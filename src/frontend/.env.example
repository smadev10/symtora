# Base URL of the Symtora API, without a trailing path.
#
# Usually leave this unset: the app then uses the machine it was loaded from
# on port 8080, so Expo Go on a phone, web and the simulators work without
# typing in an IP, even after switching Wi-Fi.
#
# Set it only when the API runs somewhere else, e.g.:
#   dotnet run (port 5014) -> http://<your-lan-ip>:5014
#   Android emulator       -> http://10.0.2.2:8080
#
# Inlined into the JS bundle at build time, so it must not contain anything
# secret. Restart Metro (npx expo start -c) after changing it.
# EXPO_PUBLIC_API_URL=http://localhost:8080
