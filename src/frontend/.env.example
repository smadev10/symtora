# Base URL of the Symtora API, without a trailing path.
#
# Inlined into the JS bundle at build time, so it must not contain anything
# secret. Copy this file to .env and adjust for your setup.
#
#   Android emulator -> http://10.0.2.2:8080
#   iOS simulator    -> http://localhost:8080
#   Physical device  -> http://<your-lan-ip>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
