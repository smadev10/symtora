{
  "expo": {
    "name": "symtora-mobile",
    "slug": "symtora-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Symtora turns your dictation into text on this device.",
        "NSMicrophoneUsageDescription": "Symtora uses the microphone so you can dictate your symptoms. Recognition runs on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#142939",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mcnomias.symtoramobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Symtora uses the microphone so you can dictate your symptoms. Recognition runs on this device.",
          "speechRecognitionPermission": "Symtora turns your dictation into text on this device."
        }
      ],
      "expo-audio",
      "expo-sharing"
    ],
    "scheme": "symtora",
    "experiments": {
      "typedRoutes": true
    }
  }
}
