# Copy to .env and fill in before running `docker compose up`.

# Postgres password used by both the db and api containers.
POSTGRES_PASSWORD=symtora

# Random secret used to sign JWTs — generate one with e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Any model tag Ollama can pull, e.g. llama3.1:8b, phi3, mistral.
OLLAMA_MODEL=llama3.1:8b
