# Copy to .env and fill in before running `docker compose up`.

# Postgres password used by both the db and api containers.
POSTGRES_PASSWORD=symtora

# Random secret used to sign JWTs — generate one with e.g. `openssl rand -base64 48`.
# Required: compose refuses to start without it. The start scripts generate it when it is empty.
JWT_SECRET=

# Any model tag Ollama can pull. llama3.2:3b answers in about a minute on CPU; llama3.1:8b
# writes better German/French but takes several minutes without a GPU.
OLLAMA_MODEL=llama3.2:3b

# Set to true to publish the browsable API reference at /scalar and the raw document at
# /openapi/v1.json. Off in the container by default — it exposes the full API surface to anyone
# who can reach the host.
EXPOSE_API_DOCS=false

# Whisper model for voice input: tiny, base, small, medium (multilingual). `small` handles
# German, French and English well enough on CPU; larger is more accurate but much slower.
WHISPER_MODEL=small

# This computer's address on the Wi-Fi, handed to Expo Go so a phone can load the app. The start
# scripts overwrite it on every start, so switching networks needs no manual change.
LAN_IP=
